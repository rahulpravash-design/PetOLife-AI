# Copy to .env.local for local dev. On a physical device, localhost won't
# reach your machine — use your LAN IP (e.g. http://192.168.1.20:3000) or an
# ngrok/tunnel URL instead.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Clerk publishable key (Clerk Dashboard -> API keys). Public by design - it is
# bundled into the app. NEVER put the Clerk secret key or JWT key here; those
# belong to the backend only. Required: the app refuses to start without it.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Release builds (`eas build --profile production`, or any build where
# __DEV__ is false) refuse to start unless EXPO_PUBLIC_API_BASE_URL is an
# https:// URL. Set this to true ONLY to deliberately test a release build
# against a local/HTTP backend. Never ship it enabled.
# EXPO_PUBLIC_ALLOW_INSECURE_API=false
