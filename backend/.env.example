# Postgres connection string. Required in production - the backend refuses
# to start in production without it (see src/lib/db.ts). Omit locally to use
# the SQLite dev database at backend/data/petolife.db instead.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Signs legacy HS256 tokens. Only needed when LEGACY_AUTH_ENABLED=true (see
# below); local dev falls back to a per-process random secret.
# JWT_SECRET=some_long_random_string

# Optional. Without it, AI narration/chat/document-extraction fall back to
# deterministic text / a "not configured" response instead of crashing.
# AI_GATEWAY_API_KEY=your_key_here

# --- Authentication -------------------------------------------------------
# Clerk is the production identity provider. All of these are SERVER-SIDE
# ONLY: never copy them into the mobile app or any EXPO_PUBLIC_* variable.
#
# PEM public key (Clerk Dashboard -> API keys -> Show JWT public key). Enables
# networkless token verification. Paste the multi-line PEM, or use literal \n.
# CLERK_JWT_KEY=
# Required to provision first-time users; also used to verify tokens via JWKS
# when CLERK_JWT_KEY is unset.
# CLERK_SECRET_KEY=sk_test_your_secret_key_here
# Optional comma-separated allowlist of token `azp` origins.
# CLERK_AUTHORIZED_PARTIES=
# Link a first-time Clerk login to an existing legacy account with the same
# verified email. Defaults to true outside production, false in production.
# CLERK_LINK_EXISTING_BY_EMAIL=false
#
# Temporary migration/compatibility only: legacy email+password login and
# self-issued HS256 tokens. Defaults to true outside production, false in
# production. Keep it false in production.
# LEGACY_AUTH_ENABLED=false
